{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ]},
    { "source": "/(.*)\\.(js|css|html)", "headers": [
      { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
    ]},
    { "source": "/", "headers": [
      { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
    ]}
  ]
}
